# High Value Todo — SPA fallback for Hetzner subdomain root deployment
# Document root: Home/public_html/todolist (serves https://todolist.codingplugs.de/)
# Vite copies this file from public/ into dist/ on build.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories (static assets, index.html, manifest, favicon)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Client-side route fallback (future-proof; app currently uses in-app view state)
  RewriteRule ^ index.html [L]
</IfModule>

# Discourage caching of the HTML shell so asset hash updates propagate after redeploy
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
